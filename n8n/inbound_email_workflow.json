          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $json.from.text || $json.from.value[0].address }}"
            },
            {
              "name": "to",
              "value": "={{ $json.to.text || $json.to.value[0].address }}"
            },
            {
              "name": "subject",
              "value": "={{ $json.subject }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "html",
              "value": "={{ $json.html }}"
            },
            {
              "name": "message_id",
              "value": "={{ $json.messageId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-1111-4a4a-9a9a-000000000002",
      "name": "Send to HomeQuoteLink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,

      "credentials": {
        "imap": {
          "id": "LGYS3R4mIZTgmMom",
          "name": "admin@homequotelink.com - IMAP account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://lrqdbpphallqehpdqalr.supabase.co/functions/v1/receive-inbound-email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-token",
